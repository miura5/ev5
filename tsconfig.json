{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["e2e", "areas", "shell", "kit", "domain", "commands", "server", "vite.config.ts"],
  "exclude": ["e2e/playwright.visual.config.ts", "server/**/*.test.ts", "kit/tokens/tokens.test.ts", "areas/notes/notePictureFrame.test.ts", "areas/notes/roundTrip.script.ts", "areas/notes/roundTrip.test.ts"]
}
