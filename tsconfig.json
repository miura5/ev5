{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
  },
  "include": ["e2e", "areas", "shell", "kit", "domain", "commands", "server", "data", "jobs", "ops", "vite.config.ts"],
  "exclude": ["ops/**/*.test.ts", "e2e/playwright.visual.config.ts", "server/**/*.test.ts", "data/**/*.test.ts", "jobs/**/*.test.ts", "data/protocol/protocol-suite.ts", "data/export/sqlite-d1.testkit.ts", "jobs/runtime/sqlite-d1.testkit.ts", "kit/tokens/tokens.test.ts", "areas/notes/notePictureFrame.test.ts"]
}
