// v5 staging Worker (CONTRACT §sec.account): names only the v5 staging Worker and D1; CI refuses a non-live config naming the live account's.
// database_id is filled in by .github/workflows/staging.yml after it creates the D1.
{
  "name": "ev5-staging",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  // Job prompts (jobs/*/prompt.md) are bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // Cron triggers run the schedule-only commands whose cadence is every:15m (server/scheduled.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "ENV_NAME": "staging" },
  "d1_databases": [{ "binding": "DB", "database_name": "ev5-staging", "migrations_dir": "data/migrations", "database_id": "00000000-0000-0000-0000-000000000000" }],
  // ev4's PlanJob Durable Object: same binding name and migration tag as ev4's config, and no deleted_classes
  // (CONTRACT §data.same-worker: removing it would delete ev4's stored state). ops/checks fails if any of it goes missing.
  "durable_objects": { "bindings": [{ "name": "PLAN_JOBS", "class_name": "PlanJob" }] },
  "migrations": [{ "tag": "v1-plan-jobs", "new_sqlite_classes": ["PlanJob"] }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "ev5-staging-images" }],
  "workflows": [{ "name": "ev5-staging-jobs", "binding": "JOBS", "class_name": "JobWorkflow" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
