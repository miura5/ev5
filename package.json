{
  "name": "ev5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:unit",
    "test:node": "node --test ops/record/ ops/checks/ ops/generate/ ops/guards/ ops/restore-drill/*.test.mjs data/tables/*.test.ts data/staging/*.test.ts data/migrations/ data/export/ server/*.test.ts jobs/*/*.test.ts",
    "test:unit": "vitest run",
    "precheck": "sh ops/setup-node.sh && npm test && npm run static",
    "static": "tsc -p . && sh ops/checks/typecheck-tests.sh && vite build && npm run lint && npm run deps && npm run stylelint && knip && node ops/record/cli.ts lint && node ops/record/cli.ts render --check && node ops/checks/cli.ts && node ops/generate/cli.ts --check",
    "checks": "node ops/checks/cli.ts",
    "generate": "node ops/generate/cli.ts",
    "generate:check": "node ops/generate/cli.ts --check",
    "typecheck": "tsc -p . && sh ops/checks/typecheck-tests.sh",
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "deps": "depcruise areas shell kit commands jobs domain data server ops --config .dependency-cruiser.cjs",
    "stylelint": "stylelint \"**/*.css\" --allow-empty-input",
    "knip": "knip",
    "test:e2e": "e2e/gate5-docker.sh",
    "test:e2e:local": "playwright test -c e2e/playwright.gate5.config.ts",
    "test:visual": "playwright test -c e2e/playwright.visual.config.ts",
    "test:visual:docker": "e2e/visual-docker.sh"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.21",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "hono": "4.13.16",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stylelint": "17.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "cmdk": "1.1.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.9",
    "wouter": "3.13.0"
  }
}
