{
  "name": "ev5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test ops/record/ ops/checks/ ops/generate/ ops/guards/ data/compat/ data/docs/*.test.ts data/migrations/ data/export/ data/scratch-check/ server/*.test.ts && vitest run",
    "checks": "node ops/checks/cli.ts",
    "scratch-check": "node data/scratch-check/cli.ts",
    "test:compat": "node --test data/compat/ data/migrations/",
    "generate": "node ops/generate/cli.ts",
    "generate:check": "node ops/generate/cli.ts --check",
    "typecheck": "tsc -p .",
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "deps": "depcruise areas shell kit commands jobs domain data server ops --config .dependency-cruiser.cjs",
    "stylelint": "stylelint \"**/*.css\" --allow-empty-input",
    "knip": "knip",
    "test:visual": "playwright test -c e2e/playwright.visual.config.ts",
    "test:visual:docker": "e2e/visual-docker.sh"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.21",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "hono": "4.13.16",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stylelint": "17.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dropdown-menu": "2.2.1"
  }
}
